{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "source": "small",
    "color": {
      "1": "#89b4fa",
      "2": "#74c7ec"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "separator": "#cdd6f4"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{1}",
      "color": {
        "user": "#89b4fa"
      }
    },
    "break",
    {
        "type": "os",
        "key": " os ",
        "keyColor": "#89b4fa"
    },
    {
        "type": "kernel",
        "key": " kernel",
        "keyColor": "#89b4fa"
    },
    {
        "type": "cpu",
        "key": " cpu ",
        "keyColor": "#74c7ec"
    },
    {
        "type": "gpu",
        "key": "󰍛 gpu ",
        "keyColor": "#74c7ec"
    },
    {
        "type": "wm",
        "key": " wm ",
        "keyColor": "#cba6f7"
    },
    {
        "type": "memory",
        "key": "󰍛 ram ",
        "keyColor": "#94e2d5"
    },
    {
        "type": "disk",
        "key": "󰋊 disk ",
        "keyColor": "#f9e2af"
    },
    {
        "type": "battery",
        "key": "󰁹 bat ",
        "keyColor": "#a6e3a1"
    },
    {
        "type": "uptime",
        "key": "󰅐 up ",
        "keyColor": "#f5c2e7"
    },
    {
        "type": "shell",
        "key": " sh ",
        "keyColor": "#cba6f7"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}